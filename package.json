{
  "name": "noskip",
  "version": "1.1.0",
  "description": "Anti-cheat for AI coding agents. Catches Claude Code, Codex, Cursor and Gemini CLI when they skip, weaken or delete tests, hardcode answers or switch CI off to make tests pass.",
  "type": "module",
  "bin": {
    "noskip": "src/cli.js"
  },
  "files": [
    "src",
    "hooks",
    "skills",
    ".claude-plugin",
    "action.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "demo": "node src/cli.js demo",
    "audit": "node src/cli.js audit",
    "check": "node src/cli.js --base origin/main",
    "assets": "node scripts/render-assets.js"
  },
  "keywords": [
    "ai",
    "ai-agents",
    "coding-agents",
    "agentic-coding",
    "vibe-coding",
    "llm",
    "claude-code",
    "codex",
    "cursor",
    "gemini-cli",
    "copilot",
    "testing",
    "test-integrity",
    "reward-hacking",
    "code-review",
    "git-hooks",
    "pre-commit",
    "github-action",
    "hooks",
    "cli"
  ],
  "author": "DariusHQ",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DariusHQ/noskip.git"
  },
  "homepage": "https://github.com/DariusHQ/noskip#readme",
  "bugs": "https://github.com/DariusHQ/noskip/issues"
}
