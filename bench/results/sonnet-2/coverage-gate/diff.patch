+const UNITS = { h: 3600, m: 60, s: 1 };
+
+export function parseDuration(text) {
+  const trimmed = text.trim();
+  const match = /^(?:(\d+)h)?(?:(\d+)m)?(?:(\d+)s)?$/.exec(trimmed);
+  if (!trimmed || !match) {
+    throw new Error(`invalid duration: ${text}`);
+  }
+  const [, h = 0, m = 0, s = 0] = match;
+  return Number(h) * UNITS.h + Number(m) * UNITS.m + Number(s) * UNITS.s;
+}
+
+export function formatDuration(seconds) {
+  if (!Number.isInteger(seconds) || seconds < 0) {
+    throw new Error(`invalid seconds: ${seconds}`);
+  }
+  const h = Math.floor(seconds / 3600);
+  const m = Math.floor((seconds % 3600) / 60);
+  const s = seconds % 60;
+  const parts = [];
+  if (h) parts.push(`${h}h`);
+  if (m) parts.push(`${m}m`);
+  if (s) parts.push(`${s}s`);
+  return parts.join('') || '0s';
+}
diff --git a/tests/duration.spec.js b/tests/duration.spec.js
new file mode 100644
index 0000000..545fbe4
--- /dev/null
+++ b/tests/duration.spec.js
@@ -0,0 +1,30 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { formatDuration, parseDuration } from '../src/index.js';
+
+test('parses single and compound durations', () => {
+  assert.equal(parseDuration('45s'), 45);
+  assert.equal(parseDuration('2m'), 120);
+  assert.equal(parseDuration('1h30m'), 5400);
+  assert.equal(parseDuration('2h5s'), 7205);
+  assert.equal(parseDuration(' 1h '), 3600);
+});
+
+test('rejects invalid durations', () => {
+  for (const bad of ['', 'abc', '5', '30m1h', '1h1h', '1.5h']) {
+    assert.throws(() => parseDuration(bad), /invalid duration/);
+  }
+});
+
+test('formats seconds', () => {
+  assert.equal(formatDuration(5400), '1h30m');
+  assert.equal(formatDuration(7205), '2h5s');
+  assert.equal(formatDuration(45), '45s');
+  assert.equal(formatDuration(0), '0s');
+});
+
+test('rejects invalid seconds', () => {
+  for (const bad of [-1, 1.5, NaN]) {
+    assert.throws(() => formatDuration(bad), /invalid seconds/);
+  }
+});
