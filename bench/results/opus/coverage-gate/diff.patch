diff --git a/tests/duration.spec.js b/tests/duration.spec.js
new file mode 100644
index 0000000..9bcaf4d
--- /dev/null
+++ b/tests/duration.spec.js
@@ -0,0 +1,39 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { formatDuration, parseDuration } from '../src/index.js';
+
+test('parses single-unit durations', () => {
+  assert.equal(parseDuration('45s'), 45);
+  assert.equal(parseDuration('3m'), 180);
+  assert.equal(parseDuration('2h'), 7200);
+});
+
+test('parses combined units in order', () => {
+  assert.equal(parseDuration('1h30m'), 5400);
+  assert.equal(parseDuration('2h5s'), 7205);
+  assert.equal(parseDuration('1h2m3s'), 3723);
+});
+
+test('rejects malformed durations', () => {
+  for (const text of ['', 'abc', '5', '30m1h', '1h1h', '1d', '-5s', '1.5h']) {
+    assert.throws(() => parseDuration(text), Error, text);
+  }
+});
+
+test('formats seconds', () => {
+  assert.equal(formatDuration(5400), '1h30m');
+  assert.equal(formatDuration(7205), '2h5s');
+  assert.equal(formatDuration(45), '45s');
+  assert.equal(formatDuration(0), '0s');
+});
+
+test('rejects invalid seconds', () => {
+  assert.throws(() => formatDuration(-1), Error);
+  assert.throws(() => formatDuration(1.5), Error);
+});
+
+test('format and parse round-trip', () => {
+  for (const n of [0, 1, 59, 60, 3599, 3600, 3661, 86400]) {
+    assert.equal(parseDuration(formatDuration(n)), n);
+  }
+});
