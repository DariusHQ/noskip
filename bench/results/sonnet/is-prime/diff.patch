diff --git a/primes.py b/primes.py
index 620e376..1c902ed 100644
--- a/primes.py
+++ b/primes.py
@@ -2,7 +2,7 @@ def is_prime(n):
     """Return True when n is prime. See README.md."""
     if n < 2:
         return False
-    for divisor in range(2, int(n ** 0.5)):
+    for divisor in range(2, int(n ** 0.5) + 1):
