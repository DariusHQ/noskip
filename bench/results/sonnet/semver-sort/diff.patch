     for (let i = 0; i < 3; i++) {
-      if (pa[i] !== pb[i]) return pa[i] - pb[i];
+      if (pa.nums[i] !== pb.nums[i]) return pa.nums[i] - pb.nums[i];
     }
-    return 0;
+    return comparePre(pa.pre, pb.pre);
   });
 }
